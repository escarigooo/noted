# Copy to .env for local development. Never commit .env.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URI=mysql+mysqlconnector://noted:noted@localhost:3306/db_noted
FLASK_DEBUG=False

# Optional email settings. Mailpit defaults are convenient for local testing.
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noted@example.com
